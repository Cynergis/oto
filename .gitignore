__pycache__/
*.pyc
*.egg-info/
.venv/
dist/
/build/
# Built artifacts — regenerated by `oto build`
*.db
*.db-wal
*.db-shm
# Never commit a project's data into the engine repo
/instances/

# Deny terms for tools/check_publishable.py — never commit this file
.oto-denylist

# pytest
.pytest_cache/

# Reference material beside the engine (prototypes, examples): never part of the package
/references/
.DS_Store

# what the test suite points the engine at instead of ~/.oto and ~/.claude
.no-user-ontologies/
.no-user-packs/
.no-claude-config/
.no-registries.json

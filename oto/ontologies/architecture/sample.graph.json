    {
      "id": "decision.adr-007",
      "type": "Decision",
      "label": "ADR-007: read invoice data only through the intake's API",
      "summary": "The scheduler and the policy read invoice data through the intake's API, never by a direct database import.",
      "attributes": {
        "rationale": "One writer and one read path keep the invoice state consistent and the schema free to change.",
        "decided_on": "2026-09-30",
        "status": "accepted"
      },

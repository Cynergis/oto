      "gate": "any"
    },
    "DD18": {
      "who": "an architect",
      "question": "Which open questions are still open on which elements of the design?",
      "why": "A hotspot is an open question raised on an element; open until a decision resolves it.",
      "validated_by": "",
      "ask": {
        "when": [
          {
            "node": "h",
            "type": "OpenQuestion",
            "where": {
              "state": "open"
            }
          },
          {
            "edge": [
              "h",
              "about",
              "x"
            ]
          },
          {
            "node": "x",
            "type": "UseCase|Subdomain|BoundedContext|ContextRelationship|DomainEvent|Command|Reaction|ReadModel|ExternalSystem|Aggregate|Entity|ValueObject|BusinessRule|DomainService"
          }
        ],
        "select": [
          "h.label",
          "x.label",
          "x.type"
        ]
      },
      "gate": "any"
    },
    "DD19": {
      "who": "anyone",
      "question": "Why was $THING designed this way: which decision, its rationale, when?",
      "why": "A design decision nobody can find is re-litigated; the product's Decision records it.",
      "validated_by": "",
      "params": {
        "THING": {
          "type": "UseCase|Subdomain|BoundedContext|ContextRelationship|DomainEvent|Command|Reaction|ReadModel|ExternalSystem|Aggregate|Entity|ValueObject|BusinessRule|DomainService"
        }
      },
      "ask": {
        "when": [

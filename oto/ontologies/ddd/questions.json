    "DD15": {
      "who": "a builder",
      "question": "What is aggregate $AGGREGATE: its root entity, its parts, what it references, its persistence and construction, and its readiness?",
      "why": "One root, one consistency boundary; the builder needs the parts and how it is persisted.",

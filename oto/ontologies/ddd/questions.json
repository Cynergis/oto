            "node": "d",
            "type": "Decision"
          }
        ],
        "select": [
          "d.label",
          "d.rationale",
          "d.decided_on"
        ]
      },
      "gate": "any",
      "gaps": {
        "when": [
          {
            "not_edge": [
              "*",
              "about",
              "$THING"
            ]
          }
        ],
        "say": "no decision is recorded about it"
      }
    },

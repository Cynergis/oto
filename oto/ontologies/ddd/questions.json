{
  "_about": "What this ontology exists to answer. Each question runs over the graph in the pattern language of rules.json; `gate` says what an empty answer means; `gaps` says why it is empty; `terms` names the vocabulary the question covers. Reasoned about in `why`, confirmed in `validated_by`.",
  "questions": {
    "DD1": {
      "who": "an architect",
      "question": "Which subdomains does the product have, of what kind, and which contexts realise each?",
      "why": "The strategic map: core, supporting and generic, each carried by one or more contexts. The first thing a builder needs.",
      "validated_by": "",
      "ask": {
        "when": [
          {
            "node": "s",
            "type": "Subdomain"
          },
          {
            "edge": [
              "s",
              "realised_in",
              "bc"
            ]
          },
          {
            "node": "bc",
            "type": "BoundedContext"
          }
        ],
        "select": [
          "s.label",
          "s.kind",
          "bc.label"
        ]
      },
      "gate": "non_empty",
      "gaps": [
        {
          "when": [
            {
              "node": "s",
              "type": "Subdomain"
            },
            {
              "not_edge": [
                "s",
                "realised_in",
                "*"
              ]
            }
          ],
          "say": "a subdomain no context realises"
        }
      ]
    },
    "DD2": {
      "who": "an architect",
      "question": "What is context $CONTEXT: which team owns it, which component carries it, its architecture style, stack, deployment unit and readiness?",
      "why": "A context is the unit of ownership, architecture and delivery; the team and the component are the estate's.",
      "validated_by": "",
      "params": {
        "CONTEXT": {
          "type": "BoundedContext"
        }
      },
      "ask": {
        "when": [
          {
            "edge": [
              "$CONTEXT",
              "owned_by",
              "t"
            ]
          },
          {
            "node": "t",
            "type": "Team"
          },
          {
            "optional": [
              {
                "edge": [
                  "$CONTEXT",
                  "deployed_as",
                  "c"
                ]
              }
            ]
          }
        ],
        "select": [
          "t.label",
          "c.label",
          "$CONTEXT.architecture_style",
          "$CONTEXT.stack",
          "$CONTEXT.deployment_unit",
          "$CONTEXT.readiness"
        ]
      },
      "gate": "non_empty",
      "gaps": {
        "when": [
          {
            "not_edge": [
              "$CONTEXT",
              "owned_by",
              "*"
            ]
          }
        ],
        "say": "no team owns the context"
      }
    },
    "DD3": {
      "who": "an architect",
      "question": "How do the contexts relate on the map: each relationship, between which contexts, which side is upstream, by what pattern and mechanism?",
      "why": "The context map is where integration cost lives; the pattern says who conforms to whom.",
      "validated_by": "",
      "ask": {
        "when": [
          {
            "node": "r",
            "type": "ContextRelationship"
          },
          {
            "edge": [
              "r",
              "between",
              "bc"
            ]
          },
          {
            "optional": [
              {
                "edge": [
                  "r",
                  "upstream",
                  "up"
                ]
              }
            ]
          }
        ],
        "select": [
          "r.label",
          "r.pattern",
          "r.mechanism",
          "bc.label",
          "up.label"
        ]
      },
      "gate": "non_empty"
    },
    "DD4": {
      "who": "a builder",
      "question": "What is use case $USECASE: who performs it, which commands does it issue, in which context does it live, which requirement does it satisfy, and is it ready?",
      "why": "The use case is the unit the builder plans from; its requirement is the trace back to the specification.",
      "validated_by": "",
      "params": {
        "USECASE": {
          "type": "UseCase"
        }
      },
      "ask": {
        "when": [
          {
            "edge": [
              "$USECASE",
              "performed_by",
              "a"
            ]
          },
          {
            "edge": [
              "$USECASE",
              "part_of",
              "bc"
            ]
          },
          {
            "node": "bc",
            "type": "BoundedContext"
          },
          {
            "optional": [
              {
                "edge": [
                  "$USECASE",
                  "issues",
                  "c"
                ]
              }
            ]
          },
          {
            "optional": [
              {
                "edge": [
                  "$USECASE",
                  "satisfies",
                  "r"
                ]
              }
            ]
          }
        ],
        "select": [
          "a.label",
          "a.type",
          "c.label",
          "bc.label",
          "r.label",
          "$USECASE.readiness"
        ]
      },
      "gate": "non_empty",
      "gaps": [
        {
          "when": [
            {
              "not_edge": [
                "$USECASE",
                "performed_by",
                "*"
              ]
            }
          ],
          "say": "nobody performs it"
        },
        {
          "when": [
            {
              "not_edge": [
                "$USECASE",
                "part_of",
                "*"
              ]
            }
          ],
          "say": "it lives in no context"
        }
      ]
    },
    "DD5": {
      "who": "a builder",
      "question": "What are the acceptance scenarios of $USECASE: given, when, then?",
      "why": "A scenario becomes a test; a use case without one is built against nobody's expectation.",
      "validated_by": "",
      "params": {
        "USECASE": {
          "type": "UseCase"
        }
      },
      "ask": {
        "when": [
          {
            "edge": [
              "s",
              "exercises",
              "$USECASE"
            ]
          },
          {
            "node": "s",
            "type": "Scenario"
          }
        ],
        "select": [
          "s.label",
          "s.given",
          "s.when",
          "s.then"
        ]
      },
      "gate": "any",
      "gaps": {
        "when": [
          {
            "not_edge": [
              "*",
              "exercises",
              "$USECASE"
            ]
          }
        ],
        "say": "no scenario exercises it"
      }
    },
    "DD6": {
      "who": "anyone",
      "question": "Which purpose justifies $THING: which value proposition or objective does it serve?",
      "why": "A use case, context or subdomain nobody can justify is scope creep with a name.",
      "validated_by": "",
      "params": {
        "THING": {
          "type": "UseCase|BoundedContext|Subdomain"
        }
      },
      "ask": {
        "when": [
          {
            "edge": [
              "$THING",
              "serves",
              "g"
            ]
          }
        ],
        "select": [
          "g.label",
          "g.type"
        ]
      },
      "gate": "any",
      "gaps": {
        "when": [
          {
            "not_edge": [
              "$THING",
              "serves",
              "*"
            ]
          }
        ],
        "say": "nothing justifies it"
      }
    },
    "DD7": {
      "who": "a builder",
      "question": "What does term $TERM mean, in which context, and what does it name?",
      "why": "The ubiquitous language: one word, one meaning, inside one context.",
      "validated_by": "",
      "params": {
        "TERM": {
          "type": "Term"
        }
      },
      "ask": {
        "when": [
          {
            "edge": [
              "$TERM",
              "part_of",
              "bc"
            ]
          },
          {
            "node": "bc",
            "type": "BoundedContext"
          },
          {
            "optional": [
              {
                "edge": [
                  "$TERM",
                  "names",
                  "x"
                ]
              }
            ]
          }
        ],
        "select": [
          "$TERM.definition",
          "bc.label",
          "x.label",
          "x.type"
        ]
      },
      "gate": "any",
      "gaps": {
        "when": [
          {
            "not_edge": [
              "$TERM",
              "part_of",
              "*"
            ]
          }
        ],
        "say": "the term belongs to no context: a product-level word, or not yet scoped"
      }
    },
    "DD8": {
      "who": "a builder",
      "question": "Which command raises event $EVENT, which aggregate emits it, and what is its payload?",
      "why": "The event is the contract between contexts; the builder needs its origin and its shape.",
      "validated_by": "",
      "params": {
        "EVENT": {
          "type": "DomainEvent"
        }
      },
      "ask": {
        "when": [
          {
            "edge": [
              "c",
              "raises",
              "$EVENT"
            ]
          },
          {
            "node": "c",
            "type": "Command"
          },
          {
            "optional": [
              {
                "edge": [
                  "$EVENT",
                  "emitted_by",
                  "agg"
                ]
              }
            ]
          }
        ],
        "select": [
          "c.label",
          "agg.label",
          "$EVENT.payload"
        ]
      },
      "gate": "any",
      "gaps": {
        "when": [
          {
            "not_edge": [
              "*",
              "raises",
              "$EVENT"
            ]
          }
        ],
        "say": "no command raises it: an external event, or a gap"
      }
    },
    "DD9": {
      "who": "a builder",
      "question": "Which event follows $EVENT in the big-picture flow?",
      "why": "The storming timeline, kept so the flow stays readable after the stickies are gone.",
      "validated_by": "",
      "params": {
        "EVENT": {
          "type": "DomainEvent"
        }
      },
      "ask": {
        "when": [
          {
            "edge": [
              "$EVENT",
              "precedes",
              "next"
            ]
          }
        ],
        "select": [
          "next.label"
        ]
      },
      "gate": "any"
    },
    "DD10": {
      "who": "an architect",
      "question": "Which contexts listen to event $EVENT?",
      "why": "Who is coupled to an event is who breaks when its payload changes.",
      "validated_by": "",
      "params": {
        "EVENT": {
          "type": "DomainEvent"
        }
      },
      "ask": {
        "when": [
          {
            "edge": [
              "ctx",
              "listens_to",

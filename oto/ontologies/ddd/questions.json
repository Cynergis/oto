    "DD24": {
      "who": "an architect",
      "question": "Which use cases satisfy no requirement of the product?",
      "why": "A use case without a requirement is behaviour nobody asked for; the trace from the design back to the specification (SA17 reads it the other way).",
      "validated_by": "",
      "ask": {
        "when": [
          {
            "node": "u",
            "type": "UseCase"
          },

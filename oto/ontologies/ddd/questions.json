            ]
          },
          {
            "node": "ctx",
            "type": "BoundedContext"
          }
        ],
        "select": [
          "ctx.label"
        ]
      },
      "gate": "any"
    },
    "DD11": {
      "who": "a builder",
      "question": "What is command $COMMAND: what triggers it and how, its schedule, payload and handler, which aggregate or service handles it, and is it ready?",
      "why": "A command's shape and handler are what the builder implements.",
      "validated_by": "",
      "params": {
        "COMMAND": {
          "type": "Command"
        }
      },
      "ask": {
        "when": [
          {
            "edge": [
              "$COMMAND",
              "handled_by",
              "h"
            ]
          },
          {
            "optional": [
              {
                "edge": [
                  "$COMMAND",
                  "triggered_by",
                  "t"
                ]
              }
            ]
          }
        ],
        "select": [
          "t.label",
          "t.type",
          "$COMMAND.trigger_kind",
          "$COMMAND.schedule",
          "$COMMAND.payload",
          "$COMMAND.handler",
          "h.label",
          "h.type",
          "$COMMAND.readiness"
        ]
      },
      "gate": "any",
      "gaps": {
        "when": [
          {
            "not_edge": [
              "$COMMAND",
              "handled_by",
              "*"
            ]
          }
        ],
        "say": "nothing handles the command"
      }
    },
    "DD12": {
      "who": "a builder",
      "question": "Which reactions fire on which events, under what condition, and which command does each issue?",
      "why": "The automation of the domain: whenever this, then that. The lilac stickies, as facts.",
      "validated_by": "",
      "ask": {
        "when": [
          {
            "node": "p",
            "type": "Reaction"
          },
          {
            "edge": [
              "p",
              "reacts_to",
              "e"
            ]
          },
          {
            "edge": [
              "p",
              "issues",
              "c"
            ]
          }
        ],
        "select": [
          "p.label",
          "p.condition",
          "e.label",
          "c.label"
        ]
      },
      "gate": "any"
    },
    "DD13": {
      "who": "a builder",
      "question": "Which read models does $ACTOR consult, with what fields, built from which events, before issuing which command?",

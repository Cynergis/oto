{
  "_about": "What this ontology exists to answer.",
  "questions": {
    "FR1": {
      "who": "the aggregator, and a person watching a run",
      "question": "What is the state of each build of $RUN: which component, in which group, after how many iterations?",
      "why": "The run at a glance: what passed, what is still building, what a person must take over.",
      "validated_by": "",
      "params": {
        "RUN": {
          "type": "Run"
        }
      },
      "ask": {
        "when": [
          {
            "edge": [
              "b",
              "build_of",
              "$RUN"
            ]
          },
          {
            "node": "b",
            "type": "Build"
          }
        ],
        "select": [
          "b",
          "b.component",
          "b.group",
          "b.state",
          "b.iterations"
        ]
      },
      "gate": "any",
      "terms": [
        "Run.started_on",
        "Run.plan",
        "Run.state",
        "Build.commit"
      ]
    },
    "FR2": {
      "who": "a person asked to take a build over",
      "question": "Which builds of $RUN are escalated to a person, after how many iterations?",
      "why": "The iteration cap ended them without a pass; someone decides what happens next.",
      "validated_by": "",
      "params": {
        "RUN": {
          "type": "Run"
        }
      },
      "ask": {
        "when": [
          {
            "edge": [
              "b",
              "build_of",
              "$RUN"
            ]
          },
          {
            "node": "b",
            "type": "Build",
            "where": {
              "state": "escalated"
            }
          }
        ],
        "select": [
          "b.component",
          "b.iterations"
        ]
      },
      "gate": "any",
      "terms": []
    },
    "FR3": {
      "who": "an engineer replaying a run",
      "question": "What happened in $BUILD, iteration by iteration: each verdict and its gaps?",
      "why": "The replay: why the loop went round, what the evaluator asked for each time.",
      "validated_by": "",
      "params": {
        "BUILD": {
          "type": "Build"
        }
      },
      "ask": {
        "when": [
          {
            "edge": [
              "i",
              "iteration_of",
              "$BUILD"
            ]
          },
          {
            "node": "i",
            "type": "Iteration"
          }
        ],
        "select": [
          "i.number",
          "i.verdict",
          "i.gaps",
          "i.at"
        ]
      },
      "gate": "any",
      "terms": [
        "follows"
      ]
    }
  }
}

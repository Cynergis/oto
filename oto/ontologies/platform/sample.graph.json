  {
   "id": "decision.d-region",
   "type": "Decision",
   "label": "Run in europe-west1",
   "summary": "Production runs in Belgium.",
   "attributes": {
    "rationale": "Card data stays in the EU, and europe-west1 has every service the product uses.",
    "decided_on": "2026-09-30",
    "status": "accepted",
    "option": "europe-west1",
    "alternatives": [
     "europe-west4"
    ],
    "consequences": "Latency for customers outside Europe is higher."
   },

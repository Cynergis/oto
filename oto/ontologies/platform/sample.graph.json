  {
   "id": "decision.d-cloud",
   "type": "Decision",
   "label": "Run on Google Cloud",
   "summary": "The payments platform runs on Google Cloud.",
   "attributes": {
    "rationale": "The company's data platform is already on Google Cloud; one cloud keeps one security model.",
    "decided_on": "2026-09-30",
    "status": "accepted",
    "option": "Google Cloud",
    "alternatives": [
     "AWS",
     "Azure"
    ],
    "consequences": "Managed services are Google's; moving off them would be a migration."
   },
   "as_of": "2026-10-14",
   "valid_from": "2026-10-14",
   "source_doc": "payments-platform-binding",

  {
   "id": "policyrule.reports-never-write-postings",
   "type": "PolicyRule",
   "label": "Reports never writes postings",
   "summary": "The reports team is refused every write on the postings, whatever else permits it.",
   "attributes": {
    "effect": "forbid",
    "priority": 100,
    "status": "active",
    "rationale": "Only the payment API writes postings; a report that could write would be a second writer."
   },

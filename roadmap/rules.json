{
  "_about": "Rules over the graph, as the communication ontology composes them.",
  "rules": [
    {
      "id": "intended-fact-overdue",
      "kind": "policy",
      "severity": "warn",
      "when": [
        {
          "node": "x",
          "where": {
            "status": "intended",
            "as_of": {
              "<": "$today-90d"
            }
          }
        }
      ],
      "then": {
        "flag": "asserted as a plan more than 90 days ago and still not observed: record the tool's run that realised it, or retire the intent"
      },
      "why": "An intended fact is a promise the graph makes about the world. A promise nobody has checked in three months is either kept and unrecorded, or broken; either way a reader must not take it as a plan still in motion.",
      "validated_by": ""
    },
    {
      "id": "needed-capability-has-a-provider",
      "kind": "policy",
      "severity": "warn",
      "when": [
        {
          "node": "c",
          "type": "Capability",
          "where": {
            "state": "needed"
          }
        },
        {
          "not_edge": [
            "*",
            "provides",
            "c"
          ]
        }
      ],
      "then": {
        "flag": "a capability the portfolio needs has no product providing it"
      },
      "why": "The gap is the finding; it must stay visible until a product provides it or the need is dropped.",
      "validated_by": "",
      "answers": "PF4"
    },
    {
      "id": "feature-serves-its-requirements-purpose",
      "kind": "derive",
      "when": [
        {
          "edge": [
            "f",
            "realises",
            "q"
          ]
        },
        {
          "edge": [
            "q",
            "serves",
            "v"
          ]
        }
      ],
      "then": {
        "edge": [
          "f",
          "serves",
          "v"
        ]
      },
      "why": "D2 asks which purpose a feature serves; documents state only which requirement it realises, and the requirement's purpose is one hop away.",
      "validated_by": ""
    },
    {
      "id": "requirement-in-scope-through-feature",
      "kind": "derive",
      "when": [
        {
          "edge": [
            "f",
            "in_scope_of",
            "r"
          ]
        },
        {
          "edge": [
            "f",
            "realises",
            "q"
          ]
        }
      ],
      "then": {
        "edge": [
          "q",
          "in_scope_of",
          "r"
        ]
      },
      "why": "B1 asks what is in scope; release plans usually list features, and a requirement realised by a scoped feature is in scope too.",
      "validated_by": ""
    },
    {
      "id": "risk-reaches-product",
      "kind": "derive",
      "when": [
        {
          "edge": [
            "k",
            "threatens",
            "f"
          ]
        },
        {
          "node": "f",
          "type": "Feature"
        },
        {
          "edge": [
            "f",
            "part_of",
            "p"
          ]
        },
        {
          "node": "p",
          "type": "Product"
        }
      ],
      "then": {
        "edge": [
          "k",
          "threatens",
          "p"
        ]
      },
      "why": "E1 asks what threatens the product; documents state the feature at risk, and the product is one part_of hop up. Typed to the feature and the product, so a pack that sits on the core derives its own hops (a risk to a component reaches its system by the estate's rule).",
      "validated_by": ""
    },
    {
      "id": "open-question-blocks-release",
      "kind": "derive",
      "when": [
        {
          "edge": [
            "o",
            "about",
            "q"
          ]
        },
        {
          "edge": [
            "q",
            "in_scope_of",
            "r"
          ]
        },
        {
          "node": "o",
          "type": "OpenQuestion",
          "where": {
            "state": "open"
          }
        }
      ],
      "then": {
        "edge": [
          "o",
          "blocks",
          "r"
        ]
      },
      "why": "C2 asks what is still open before a build; an open question about an in-scope requirement blocks that release, and nobody writes that down. Only questions in state open count; a resolved one must not block (found by the sample graph, 2026-09-27).",
      "validated_by": ""
    },
    {
      "id": "product-pursues-objective",
      "kind": "derive",
      "when": [
        {
          "edge": [
            "p",
            "offers",
            "v"
          ]
        },
        {
          "edge": [
            "v",
            "serves",
            "o"
          ]
        },
        {
          "node": "o",
          "type": "Objective"
        }
      ],
      "then": {
        "edge": [
          "p",
          "pursues",
          "o"
        ]
      },
      "why": "G2 asks how the product aligns with objectives; documents state which promise serves which objective, and the product-level edge is one hop away.",
      "validated_by": ""
    },
    {
      "id": "requirement-serves-a-purpose",
      "kind": "policy",
      "severity": "warn",
      "when": [
        {
          "node": "q",
          "type": "Requirement"
        },
        {
          "not_edge": [
            "q",
            "serves",
            "*"
          ]
        }
      ],
      "then": {
        "flag": "a requirement must trace to the value proposition it serves"
      },
      "why": "Failure F3: a requirement with no traceable reason gets built or dropped arbitrarily.",
      "validated_by": "",
      "answers": "PR4"
    },
    {
      "id": "value-proposition-has-success-criterion",
      "kind": "policy",
      "severity": "warn",
      "when": [
        {
          "node": "v",
          "type": "ValueProposition"
        },
        {
          "not_edge": [
            "*",
            "measures",
            "v"
          ]
        }
      ],
      "then": {
        "flag": "a value proposition must have at least one success criterion that measures it"
      },
      "why": "Failure F4: success was never defined, so nobody could say when the product was done.",
      "validated_by": "",
      "answers": "PR5"
    },
    {
      "id": "decision-is-documented",
      "kind": "policy",
      "severity": "warn",
      "when": [
        {
          "node": "d",
          "type": "Decision"
        },
        {
          "not_edge": [
            "d",
            "documented_in",
            "*"
          ]
        }
      ],
      "then": {
        "flag": "a decision must cite the document that records it"
      },
      "why": "C4 and failure F2: a decision nobody can open is a rumour, and the graph would carry it as fact.",
      "validated_by": "",
      "answers": "PR19"
    },
    {
      "id": "scope-is-not-contradictory",
      "kind": "policy",
      "severity": "blocking",
      "when": [
        {
          "edge": [
            "q",
            "in_scope_of",
            "r"
          ]
        },
        {
          "edge": [
            "q",
            "excluded_from",
            "r"
          ]
        }
      ],
      "then": {
        "flag": "something is both in scope of and excluded from the same release; supersede one of the two"
      },
      "why": "Failure F1: a builder agent cannot see the boundary if the graph says both; the older fact must be superseded, not left standing.",
      "validated_by": "",
      "answers": "PR6"
    },
    {
      "id": "shipped-release-is-not-blocked",
      "kind": "policy",
      "severity": "warn",
      "when": [
        {
          "edge": [
            "o",
            "blocks",
            "r"
          ]
        },
        {
          "node": "r",
          "type": "Release",
          "where": {
            "state": "shipped"
          }
        }
      ],
      "then": {
        "flag": "a release marked shipped still has an open question blocking it"
      },
      "why": "C2 and B1 together: a release that shipped with a question still open means either the state or the question is stale, and someone should say which.",
      "validated_by": "",
      "answers": "PR18"
    },
    {
      "id": "risk-reaches-system",
      "kind": "derive",
      "when": [
        {
          "edge": [
            "r",
            "threatens",
            "c"
          ]
        },
        {
          "edge": [
            "c",
            "part_of",
            "s"
          ]
        }
      ],
      "then": {
        "edge": [
          "r",
          "threatens",
          "s"
        ]
      },
      "why": "A risk to a component is a risk to its system, and documents state only the component. Impact questions need the system.",
      "validated_by": ""
    },
    {
      "id": "consumer-depends-on-provider",
      "kind": "derive",
      "when": [
        {
          "edge": [
            "a",
            "consumes",
            "i"
          ]
        },
        {
          "edge": [
            "b",
            "exposes",
            "i"
          ]
        }
      ],
      "then": {
        "edge": [
          "a",
          "depends_on",
          "b"
        ]
      },
      "why": "Change-impact questions need the dependency between components; documents state the interface each side touches, not the dependency.",
      "validated_by": ""
    },
    {
      "id": "state-follows-the-current-transition",
      "kind": "derive",
      "when": [
        {
          "node": "t",
          "type": "Transition"
        },
        {
          "edge": [
            "t",
            "transition_of",
            "w"
          ]
        }
      ],
      "then": {
        "attribute": [
          "w",
          "state",
          "$t.to"
        ]
      },
      "why": "An item's state is what its latest recorded change says, never what someone typed on the item. Each transition supersedes the one before, so the rule sees one current transition per item and the chain is the history. An item with no transition is open, the attribute's default.",
      "validated_by": ""
    },
    {
      "id": "deployed-to-follows-the-deployment",
      "kind": "derive",
      "when": [
        {
          "node": "t",
          "type": "Transition",
          "where": {
            "to": "deployed"
          }
        },
        {
          "edge": [
            "t",
            "transition_of",
            "w"
          ]
        }
      ],
      "then": {
        "attribute": [
          "w",
          "deployed_to",
          "$t.environment"
        ]
      },
      "why": "Where an item is deployed is a fact of the deployment that put it there, not something written on the item.",
      "validated_by": ""
    },
    {
      "id": "a-block-is-a-transition-to-blocked",
      "kind": "policy",
      "severity": "blocking",
      "when": [
        {
          "node": "b",
          "type": "Block",
          "where": {
            "to": {
              "!=": "blocked"
            }
          }
        }
      ],
      "then": {
        "flag": "a block is a transition to blocked; a transition to anything else is a plain Transition"
      },
      "why": "A Block carries a reason and a waiting-on because the item is blocked; one that moves the item elsewhere would carry context for a state the item is not in.",
      "validated_by": "",
      "answers": "WK11"
    },
    {
      "id": "a-deployment-names-its-environment",
      "kind": "policy",
      "severity": "blocking",
      "when": [
        {
          "node": "t",
          "type": "Transition",
          "where": {
            "to": "deployed",
            "environment": {
              "exists": false
            }
          }
        }
      ],
      "then": {
        "flag": "a transition to deployed must say which environment: qa, preprod or prod"
      },
      "why": "Deployed to qa and deployed to prod are different facts; a deployment to nowhere in particular answers nothing.",
      "validated_by": "",
      "answers": "WK12"
    },
    {
      "id": "item-is-overdue",
      "kind": "policy",
      "severity": "warn",
      "when": [
        {
          "node": "w",
          "type": "WorkItem",
          "where": {
            "due": {
              "<": "$today"
            },
            "state": {
              "in": [
                "open",
                "blocked"
              ]
            }
          }
        }
      ],
      "then": {
        "flag": "a work item is past its due date and not deployed"
      },
      "why": "The plan must say when it slipped, not hide it.",
      "validated_by": "",
      "answers": "WK6"
    },
    {
      "id": "message-is-resolved",
      "kind": "derive",
      "when": [
        {
          "node": "r",
          "type": "Message",
          "where": {
            "outcome": "resolved"
          }
        },
        {
          "edge": [
            "r",
            "in_reply_to",
            "m"
          ]
        }
      ],
      "then": {
        "attribute": [
          "m",
          "status",
          "resolved"
        ]
      },
      "why": "What was asked is settled when a reply says so; the status is derived so nobody edits a message. Declared before the replied rule: a derived value is set once, so a message with a resolving reply among others is resolved.",
      "validated_by": ""
    },
    {
      "id": "message-is-replied",
      "kind": "derive",
      "when": [
        {
          "node": "r",
          "type": "Message"
        },
        {
          "edge": [
            "r",
            "in_reply_to",
            "m"
          ]
        }
      ],
      "then": {
        "attribute": [
          "m",
          "status",
          "replied"
        ]
      },
      "why": "A message with an answer is no longer pending; it stays open until a reply settles it.",
      "validated_by": ""
    },
    {
      "id": "message-names-a-recipient",
      "kind": "policy",
      "severity": "blocking",
      "when": [
        {
          "node": "m",
          "type": "Message"
        },
        {
          "not_edge": [
            "m",
            "sent_to",
            "*"
          ]
        },
        {
          "not_edge": [
            "m",
            "in_reply_to",
            "*"
          ]
        }
      ],
      "then": {
        "flag": "a message that answers nothing must say whom it is for"
      },
      "why": "A message nobody receives waits for nobody; a reply reaches whoever asked, so it may name no one.",
      "validated_by": "",
      "answers": "CM1"
    },
    {
      "id": "message-is-overdue",
      "kind": "policy",
      "severity": "warn",
      "when": [
        {
          "node": "m",
          "type": "Message",
          "where": {
            "due": {
              "<": "$today"
            },
            "status": {
              "in": [
                "pending",
                "read",
                "replied"
              ]
            }
          }
        }
      ],
      "then": {
        "flag": "a message is past its due date and not resolved"
      },
      "why": "A question nobody answered by the date it was needed is a blocked item staying blocked; the plan must say so.",
      "validated_by": "",
      "answers": "CM3"
    }
  ]
}

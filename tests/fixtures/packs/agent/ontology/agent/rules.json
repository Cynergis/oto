          }
        },
        {
          "edge": [
            "h",
            "about",
            "j"
          ]
        },
        {
          "node": "j",
          "type": "Job",
          "where": {
            "readiness": "ready"
          }
        }
      ],
      "then": {
        "flag": "a job marked ready still has an open question on it"

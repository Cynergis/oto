{
  "name": "Northwind Fleet",
  "about": "An analyst builds a fleet-maintenance knowledge base from four documents and two conversations: ingest, survey, vocabulary, capture, curate with a supersession, build, the competency questions, rules, bench and feedback. The reference path: every gate passes once the analyst has done what it asked.",
  "requires": ["docx", "openpyxl"],
  "sources": "sources.py",
  "steps": [
    {"say": "set up the project", "run": ["init", "--name", "Northwind Fleet"]},
    {"say": "drop the four documents in the inbox", "inbox": ["Fleet Maintenance Policy 2025.docx", "Incident Review - Bus 4127.md",
                                                           "Parts Inventory Q3.xlsx", "Vendor Integration Notes.txt"]},
    {"say": "ingest: the notes carry a credential and are blocked", "run": ["ingest"], "exit": 1,
     "out": ["BLOCKED Vendor Integration Notes.txt", "credential: AWS access key id", "personal data: email address",
             "extracted 3, blocked 1"], "snapshot": {"sources.errors": {"len": 1}, "sources.errors.0.file": "Vendor Integration Notes.txt", "stations.sources.state": "attention", "stations.build.state": "not_started"}},
    {"say": "the analyst redacts the key and drops the notes back", "write": "inbox/Vendor Integration Notes.txt",
     "text": "Telematics vendor integration notes\n\nThe telematics feed posts odometer readings for every Bus nightly.\nTest credentials used during setup: [REDACTED]\nThe PM Schedule alert reads the odometer from this feed.\n"},
    {"run": ["ingest"], "out": ["Vendor Integration Notes.txt -> documents/vendor-integration-notes.md", "blocked 0"]},

    {"say": "survey the corpus", "run": ["survey"],
     "out": ["4 document(s)", "Central Garage", "Work Order   also: Work Orders", "BRK-221", "PM-B"]},
    {"run": ["survey", "accept", "--term", "East Garage", "--as", "entity", "--by", "Sam Lee", "--at", "2025-10-20"]},
    {"run": ["survey", "accept", "--term", "Central Garage", "--as", "entity", "--by", "Sam Lee", "--at", "2025-10-20"]},
    {"run": ["survey", "accept", "--term", "Maintenance Supervisor", "--as", "entity", "--by", "Sam Lee", "--at", "2025-10-20"]},
    {"run": ["survey", "accept", "--term", "Fleet Manager", "--as", "entity", "--by", "Sam Lee", "--at", "2025-10-20"]},
    {"run": ["survey", "accept", "--term", "PM-B", "--as", "entity", "--by", "Sam Lee", "--at", "2025-10-20"], "out": ["via codes"]},
    {"run": ["survey", "accept", "--term", "Work Orders", "--as", "class", "--by", "Sam Lee", "--at", "2025-10-20"], "out": ["via plurals"]},
    {"run": ["survey", "reject", "--term", "Fleet Maintenance Policy 2025", "--by", "Sam Lee", "--at", "2025-10-20", "--note", "a document title"]},
    {"run": ["survey", "reject", "--term", "Q3", "--by", "Sam Lee", "--at", "2025-10-20", "--note", "a quarter, not a term"]},
    {"run": ["survey", "decisions"], "out": ["counted      accepted 6, rejected 2"]},

    {"say": "the vocabulary: a sheet, then the interview's changes, rationale and questions", "id": "vocabulary",
     "run": ["ontology", "import", "--file", "{scenario}/vocabulary/vocabulary.csv"], "out": ["wrote 8 class(es), 11 relation(s)"]},
    {"put": "vocabulary/interview"},
    {"run": ["ontology", "check"], "out": ["questions: 6 declared"]},
    {"id": "vocabulary-accepted", "run": ["ontology", "accept"],
     "out": ["accepted vocabulary version 1 (9 classes, 11 relations, 0 rules, 6 questions)"], "snapshot": {"vocabulary.accepted": true, "stations.vocabulary.line": "v1 · 2 of 9 confirmed", "stations.survey.line": "6 accepted · 2 rejected", "open": {"has": "7 of 9 kinds of thing are unconfirmed"}}},

    {"say": "Dana Reyes tells the analyst PM-B changed; the graph is empty, so the names cannot resolve yet",
     "run": ["capture", "--title", "PM-B interval change", "--by", "Dana Reyes, Fleet Manager", "--at", "2025-09-01",
             "--recorded-by", "Sam Lee, analyst",
             "--statement", "From 1 September the PM-B interval is 20,000 km, not 24,000.",
             "--statement", "PM-B can now also be done at East Garage.",
             "--about", "PM-B,East Garage", "--context", "Said during the Bus 4127 incident follow-up meeting"],
     "warnings": ["about 'PM-B': no such id or name in the graph", "about 'East Garage': no such id or name in the graph"]},
    {"run": ["ingest"], "out": ["2025-09-01-pm-b-interval-change.md -> documents/2025-09-01-pm-b-interval-change.md"]},
    {"run": ["survey", "reject", "--term", "Dana Reyes", "--by", "Sam Lee", "--at", "2025-10-20", "--note", "a person; roles, not people, are modelled"]},

    {"say": "curate batch 1: the policy, the incident review (as first drafted) and the stock sheet",
     "run": ["curate", "start"]},
    {"run": ["curate", "add", "--from", "{scenario}/proposals/fleet-maintenance-policy-2025.json"]},
    {"run": ["curate", "add", "--from", "{scenario}/proposals/incident-review-bus-4127.draft.json"]},
    {"run": ["curate", "add", "--from", "{scenario}/proposals/parts-inventory-q3.json"]},
    {"say": "the value check: WO-2291's date is in the review, not in the sentence quoted", "run": ["curate", "check"],
     "findings": {"gap": [["wo.wo-2291", "opened_on = '2025-08-02' is in incident-review-bus-4127 but not in the quotes it cites"]]}, "snapshot": {"curate.candidate": true, "stations.curate.state": "attention", "open": {"has": "A change is open and not applied"}}},
    {"say": "the drafter quotes the sentence that states the date", "run": ["curate", "add", "--from", "{scenario}/proposals/incident-review-bus-4127.json"]},
    {"run": ["curate", "check"], "findings": {}, "out": ["ready to apply"]},
    {"run": ["curate", "apply", "--by", "Sam Lee, analyst", "--note", "Policy, Bus 4127 incident review and Q3 stock."]},

    {"say": "curate batch 2: the captured PM-B change, a supersession", "run": ["curate", "start"]},
    {"run": ["curate", "add", "--from", "{scenario}/proposals/2025-09-01-pm-b-interval-change.json", "--dry-run"],
     "out": ["updated  pm.pm-b                      valid_to, status, superseded_by, change_note",
             "SUSPECT  pm.pm-b-2025-09              same name as pm.pm-b"]},
    {"run": ["curate", "add", "--from", "{scenario}/proposals/2025-09-01-pm-b-interval-change.json"]},
    {"run": ["curate", "check"], "findings": {}, "out": ["ready to apply"]},
    {"run": ["curate", "apply", "--by", "Sam Lee, analyst", "--note", "PM-B is 20,000 km from 2025-09-01; the 24,000 km fact is retired."]},
    {"run": ["build"], "out": ["21 nodes, 24 edges (0 derived)", "6 questions"], "snapshot": {"build.built": true, "build.current": 20, "build.superseded": 1, "overview.questions": {"declared": 6, "answered": 6}, "curate.changes.0.retired.0.id": "pm.pm-b", "curate.changes.0.retired.0.superseded_by": "pm.pm-b-2025-09"}},

    {"say": "the competency questions", "run": ["query", "ask", "CQ1", "GARAGE=East Garage"], "out": ["status: answered"],
     "rows": [{"wo.number": "WO-2291", "wo.opened_on": "2025-08-02", "b.fleet_number": "4127"}]},
    {"run": ["query", "ask", "CQ3", "IR=ir.2025-08-02-bus-4127"], "rows": [{"wo.number": "WO-2291", "p.part_number": "BRK-221"}]},
    {"run": ["query", "ask", "CQ4", "PM=PM-B"],
     "rows": [{"$PM.interval_km": "20000", "g.label": "Central Garage", "r.label": "Fleet Manager"},
              {"$PM.interval_km": "20000", "g.label": "East Garage", "r.label": "Fleet Manager"}]},
    {"run": ["query", "ask", "CQ5", "GARAGE=Central Garage"],
     "rows": [{"p.part_number": "BRK-220", "s.quantity": "40", "s.reorder_at": "25"},
              {"p.part_number": "BRK-221", "s.quantity": "18", "s.reorder_at": "25"}]},
    {"run": ["query", "ask", "CQ6", "ROUTE=Route 12"], "out": ["status: answered", "4127"]},
    {"say": "history: what was believed before the change", "run": ["query", "entity", "PM-B", "--as-of", "2025-08-15"],
     "out": ["(pm.pm-b)", "status=superseded", "valid_to=2025-09-01", "interval km: 24000"]},
    {"id": "pm-b-built", "run": ["ingest", "complete"], "out": ["5 file(s) archived"]},

    {"say": "Priya Nair reports a work order: as first said, it dates itself by 'today' and names a retired fact",
     "run": ["capture", "--title", "WO-2304 PM-B at East Garage", "--by", "Priya Nair, Maintenance Supervisor, East Garage",
             "--at", "2025-10-02", "--statement", "I opened WO-2304 today for the PM-B service on Bus 4127, here at East Garage.",
             "--about", "bus.4127,pm.pm-b,East Garage"],
     "warnings": ["statement 1 dates itself by 'today' (2025-10-02",
                  "about 'pm.pm-b' is superseded; its current version is 'pm.pm-b-2025-09'",
                  "about 'East Garage' is not an id; it names garage.east (label)"]},
    {"say": "asked, she gives the date and the part; the note is written again",
     "run": ["capture", "--title", "WO-2304 PM-B at East Garage", "--by", "Priya Nair, Maintenance Supervisor, East Garage",
             "--at", "2025-10-02", "--statement", "I opened WO-2304 on 2 October for the PM-B service on Bus 4127, here at East Garage.",
             "--statement", "The job needs an FLT-010 filter.", "--about", "bus.4127,pm.pm-b-2025-09,garage.east", "--force"],
     "warnings": []},
    {"run": ["ingest"], "out": ["extracted 1"]},
    {"run": ["curate", "start"]},
    {"run": ["curate", "add", "--from", "{scenario}/proposals/2025-10-02-wo-2304-pm-b-at-east-garage.json"]},
    {"run": ["curate", "check"], "findings": {}, "out": ["ready to apply"]},
    {"run": ["curate", "apply", "--by", "Sam Lee, analyst", "--note", "WO-2304, from Priya Nair's captured statement."]},

    {"say": "rules: a derived relation, two policies and the question they answer", "put": "vocabulary/rules"},
    {"run": ["ontology", "accept"], "out": ["accepted vocabulary version 1 (9 classes, 12 relations, 3 rules, 7 questions)"]},
    {"run": ["build"], "out": ["3 rule(s) in 2 round(s): 4 edge(s) and 0 attribute(s) derived, 3 policy finding(s)",
                                "22 nodes, 31 edges (4 derived)"]},
    {"run": ["ingest", "complete"], "out": ["1 file(s) archived"]},
    {"run": ["query", "policy"],
     "out": ["open-work-order-part-not-stocked: WO-2291 (wo.wo-2291)", "stock-at-reorder-point: BRK-221 at Central Garage",
             "stock-at-reorder-point: TYR-305 at East Garage", "Policy findings (3)"]},
    {"run": ["query", "explain", "East Garage", "stocks"],
     "out": ["garage.east -stocks-> part.flt-010  derived by rule garage-stocks-part",
             "garage.east -stocks-> part.tyr-305  derived by rule garage-stocks-part"]},
    {"run": ["query", "ask", "CQ7", "GARAGE=East Garage"],
     "rows": [{"p.part_number": "FLT-010"}, {"p.part_number": "TYR-305"}]},

    {"say": "bench: the graph against a lexical baseline, scored so a wrong answer costs more than none",
     "put": "gold", "to": "gold"},
    {"run": ["bench", "--systems", "oto,lexical"], "bench": {"oto": {"score": 0.0, "precision": 0.5}}, "beats": {"oto": ["lexical"]}},

    {"say": "feedback from readers, and the one that names the right answer becomes a gold question",
     "run": ["feedback", "record", "--question", "Which garage stocks rear brake pads?", "--verdict", "right",
             "--by", "Priya Nair, Maintenance Supervisor", "--at", "2025-10-07", "--source", "parts-inventory-q3"]},
    {"run": ["feedback", "record", "--question", "Which parts at East Garage are at or below their reorder point?",
             "--verdict", "incomplete", "--by", "Dana Reyes, Fleet Manager", "--at", "2025-10-07",
             "--expected", "TYR-305: 12 on hand, reorder point 16", "--source", "parts-inventory-q3"]},
    {"run": ["feedback", "record", "--question", "Is WO-2291 still open?", "--verdict", "wrong",
             "--by", "Dana Reyes, Fleet Manager", "--at", "2025-10-07", "--given", "state: open"],
     "out": ["recorded fb-0003: wrong", "This cannot become a test yet"]},
    {"run": ["feedback", "promote"], "out": ["promoted 1 question(s)", "fb-0002 -> from-fb-0002"], "snapshot": {"overview": {"facts": 21, "documents": 4, "conversations": 2, "questions": {"declared": 7, "answered": 7}}, "stations.rules.line": "3 rules · 3 warnings", "rules.findings": {"len": 3}, "test.bench.systems.oto.score": {"min": 0}, "test.gold.questions": 15, "open": {"has": "Is WO-2291 still open?"}, "stations.deploy.state": "not_started"}}
  ]
}

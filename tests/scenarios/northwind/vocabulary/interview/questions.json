{
  "questions": {
    "CQ1": {
      "who": "Maintenance Supervisor",
      "question": "Which work orders are open at garage $GARAGE, and for which bus?",
      "why": "The supervisor assigns and closes work orders per garage; an open order nobody sees is a bus off the road.",
      "validated_by": "",
      "params": {
        "GARAGE": {
          "type": "Garage"
        }
      },
      "ask": {
        "when": [
          {
            "edge": [
              "wo",
              "raised_at",
              "$GARAGE"
            ]
          },
          {
            "node": "wo",
            "type": "WorkOrder",
            "where": {
              "state": "open"
            }
          },
          {
            "edge": [
              "wo",
              "for_bus",
              "b"
            ]
          },
          {
            "node": "b",
            "type": "Bus"
          }
        ],
        "select": [
          "wo.number",
          "wo.opened_on",
          "b.fleet_number"
        ]
      },
      "gate": "any",
      "gaps": {
        "when": [
          {
            "node": "$GARAGE",
            "type": "Garage"
          }
        ],
        "say": "no open work order at this garage"
      }
    },
    "CQ2": {
      "who": "Safety Officer",
      "question": "Which incident reports concern bus $BUS, when did they happen, and which role reviews them?",
      "why": "The policy requires every incident report to be reviewed within five working days; repeated incidents on one bus are the signal to act on.",
      "validated_by": "",
      "params": {
        "BUS": {
          "type": "Bus"
        }
      },
      "ask": {
        "when": [
          {
            "edge": [
              "ir",
              "about_bus",
              "$BUS"
            ]
          },
          {
            "node": "ir",
            "type": "IncidentReport"
          },
          {
            "edge": [
              "ir",
              "reviewed_by",
              "r"
            ]
          },
          {
            "node": "r",
            "type": "Role"
          }
        ],
        "select": [
          "ir.label",
          "ir.occurred_on",
          "r.label"
        ]
      },
      "gate": "any",
      "gaps": {
        "when": [
          {
            "node": "$BUS",
            "type": "Bus"
          }
        ],
        "say": "no incident has been reported for this bus"
      }
    },
    "CQ3": {

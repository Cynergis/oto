    "CQ4": {
      "who": "Fleet Manager",
      "question": "What is the interval of PM level $PM, which garages may perform it, and which role approves a change to it?",
      "why": "The PM-B alert failure on Bus 4127 raised exactly this question, and the answer changed on 2025-09-01; it must be answerable as of any date.",
      "validated_by": "",
      "params": {
        "PM": {
          "type": "PMLevel"
        }
      },
      "ask": {
        "when": [
          {
            "edge": [
              "$PM",
              "performed_at",
              "g"
            ]
          },
          {
            "node": "g",
            "type": "Garage"
          },
          {
            "edge": [
              "$PM",
              "approved_by",
              "r"
            ]
          },
          {
            "node": "r",
            "type": "Role"
          }
        ],
        "select": [
          "$PM.interval_km",
          "g.label",
          "r.label"
        ]
      },
      "gate": "non_empty"
    },
    "CQ5": {
      "who": "Maintenance Supervisor",
      "question": "How many of each part does garage $GARAGE hold, and at what level must it reorder?",
      "why": "East Garage had no BRK-221 when Bus 4127 came in; the supervisor needs stock against reorder points per garage before work is scheduled.",
      "validated_by": "",
      "params": {
        "GARAGE": {
          "type": "Garage"
        }
      },
      "ask": {
        "when": [
          {
            "edge": [
              "s",
              "held_at",
              "$GARAGE"
            ]
          },
          {
            "node": "s",
            "type": "StockLevel"
          },
          {
            "edge": [
              "s",

{
  "name": "OTO Roadmap",
  "about": "The roadmap as the first work project: its fourteen epics and six phases from the roadmap document, Epic L deployed by its merged pull requests, Epic B marked deployed by a merged-PR event delivered twice, Epic M blocked on a decision and the person who takes it, told with a message that waits in their inbox, then unblocked by the resolving reply; the board and its questions answer at each step, the block's history stays readable, and the published copy shows the people as initials. What `oto work set`, `notify`, `reply` and `event` refuse is refused.",
  "requires": [],
  "sources": "sources.py",
  "steps": [
    {
      "say": "an empty project on the communication ontology (which extends work): the vocabulary, no sample",
      "run": [
        "init",
        "--name",
        "OTO Roadmap",
        "--ontology",
        "communication",
        "--empty"
      ]
    },
    {
      "inbox": [
        "oto-roadmap.md"
      ]
    },
    {
      "run": [
        "ingest"
      ],
      "out": [
        "oto-roadmap.md -> documents/oto-roadmap.md",
        "blocked 0"
      ]
    },
    {
      "say": "the roadmap, drafted: phases as milestones, epics as items, Epic L already deployed",
      "run": [
        "curate",
        "start"
      ]
    },
    {
      "run": [
        "curate",
        "add",
        "--from",
        "{scenario}/proposals/oto-roadmap.json"
      ]
    },
    {
      "run": [
        "curate",
        "check"
      ],
      "findings": {
        "gap": [
          [
            "(graph)",
            "question CORE2 unanswered"
          ],
          [
            "(graph)",
            "question PF1 unanswered"
          ],
          [
            "(graph)",
            "question PF2 unanswered"
          ],
          [
            "(graph)",
            "question PF6 unanswered"
          ],
          [
            "(graph)",
            "question PR4 unanswered"
          ],
          [
            "(graph)",
            "question SA10 unanswered"
          ]
        ]
      },
      "out": [
        "ready to apply"
      ],
      "say": "the gates: clean but for the base ontologies' questions an empty roadmap cannot answer yet"
    },
    {
      "run": [
        "curate",
        "apply",
        "--by",
        "Chiheb Dkhil",
        "--note",
        "The roadmap's six phases and fourteen epics; Epic L shipped."
      ]
    },
    {
      "run": [
        "build"
      ]
    },
    {
      "say": "the board: what is deployed, and nothing is blocked yet",
      "run": [
        "query",
        "ask",
        "WK12"
      ],
      "rows": [
        {
          "w.label": "Epic L: selected text and tools",
          "w.deployed_to": "prod"
        }
      ]
    },
    {
      "run": [
        "query",
        "ask",
        "WK11"
      ],
      "not_out": [
        "Epic"
      ]
    },
    {
      "say": "Epic M blocks on a decision, waiting on the person who takes it",
      "run": [
        "work",
        "set",
        "Epic M",
        "--state",
        "blocked",
        "--reason",
        "the state model needs a decision: supersede each transition, or aggregate the latest",
        "--waiting-on",
        "Chiheb Dkhil",
        "--by",
        "Claude, in session",
        "--at",
        "2026-10-24"
      ],
      "out": [
        "Epic M: work pack: open -> blocked, waiting on person.chiheb",
        "transition transition.epic-m-1 appended"
      ]
    },
    {
      "run": [
        "build"
      ]
    },
    {
      "run": [
        "query",
        "ask",
        "WK11"
      ],
      "rows": [
        {
          "w.label": "Epic M: work pack",
          "b.at": "2026-10-24",
          "x.label": "Chiheb Dkhil",
          "x.type": "Person"
        }
      ]
    },
    {
      "say": "the board: blocked by whom it waits on, and the snapshot carries the same",
      "run": [
        "work",
        "board"
      ],
      "out": [
        "blocked (1), by whom or what it waits on:",
        "Chiheb Dkhil (Person)",
        "Epic M: work pack",
        "since 2026-10-24, raised by Claude, in session",
        "deployed (1)",
        "prod",
        "Epic L: selected text and tools",
        "open (12)"
      ],
      "snapshot": {
        "work.counts.blocked": 1,
        "work.counts.open": 12,
        "work.counts.deployed": 1,
        "work.blocked.0.waiting_on.label": "Chiheb Dkhil",
        "work.deployed.0.environment": "prod"
      }
    },
    {
      "say": "notify: the message carries the item and the block's reason, to the person it waits on",
      "run": [
        "work",
        "notify",
        "Epic M",
        "--by",
        "Claude, in session",
        "--at",
        "2026-10-24",
        "--due",
        "2026-10-27",
        "--body",
        "Supersede or aggregate: which?"
      ],
      "out": [
        "Epic M: work pack: message message.epic-m-1 to Chiheb Dkhil, due 2026-10-27, pending"
      ]
    },
    {
      "run": [
        "build"
      ]
    },
    {
      "run": [
        "query",
        "ask",
        "CM1",
        "PERSON=person.chiheb"
      ],
      "rows": [
        {
          "m.from": "Claude, in session",
          "m.sent": "2026-10-24",
          "m.due": "2026-10-27",
          "w.label": "Epic M: work pack"
        }
      ],
      "out": [
        "supersede each transition, or aggregate the latest",
        "Supersede or aggregate: which?"
      ]
    },
    {
      "say": "a notification needs a block; the published copy shows the person as initials",
      "run": [
        "work",
        "notify",
        "Epic L",
        "--by",
        "Claude, in session",
        "--at",
        "2026-10-24"
      ],
      "exit": 1,
      "out": [
        "not blocked"
      ]
    },
    {
      "run": [
        "build",
        "--target",
        "site",
        "--view",
        "workbench"
      ],
      "out": [
        "published snapshot written"
      ],
      "file": "build/site/snapshot.json",
      "json": {
        "work.counts.blocked": 1,
        "work.blocked.0.waiting_on.label": "C.D.",
        "published": true,
        "work.counts.deployed": 1
      }
    },
    {
      "say": "a session opens: the inbox, what waits for the person",
      "run": [
        "work",
        "inbox",
        "--as",
        "person.chiheb"
      ],
      "out": [
        "1 pending for Chiheb Dkhil",
        "message.epic-m-1 · from Claude, in session · re Epic M: work pack (blocked since 2026-10-24) · due 2026-10-27",
        "Supersede or aggregate: which?",
        "oto work reply message.epic-m-1"
      ]
    },
    {
      "say": "the decision is taken in the reply, which resolves the message and lifts the block",
      "run": [
        "work",
        "reply",
        "message.epic-m-1",
        "--resolve",
        "--body",
        "Supersede: each transition supersedes the one before; history is the chain.",
        "--by",
        "Chiheb Dkhil",
        "--at",
        "2026-10-25"
      ],
      "out": [
        "message.epic-m-1: message.epic-m-2 resolved, by Chiheb Dkhil (2026-10-25)",
        "Epic M: work pack: blocked -> open; transition transition.epic-m-2 appended"
      ]
    },
    {
      "run": [
        "work",
        "inbox",
        "--as",
        "person.chiheb"
      ],
      "out": [
        "nothing pending for Chiheb Dkhil"
      ]
    },
    {
      "run": [
        "build"
      ]
    },
    {
      "run": [
        "query",
        "ask",
        "WK11"
      ],
      "not_out": [
        "Epic M"
      ]
    },
    {
      "run": [
        "query",
        "ask",
        "WK13",
        "ITEM=workitem.epic-m"
      ],
      "rows": [
        {
          "t.to": "open",
          "t.at": "2026-10-25",
          "t.by": "Chiheb Dkhil"
        }
      ]
    },
    {
      "say": "history: what was believed while it was blocked",
      "run": [
        "query",
        "entity",
        "transition.epic-m-1",
        "--as-of",
        "2026-10-24"
      ],
      "out": [
        "status=superseded",
        "valid_to=2026-10-25",
        "blocked"
      ]
    },
    {
      "say": "what the command refuses",
      "run": [
        "work",
        "set",
        "Epic M",
        "--state",
        "deployed",
        "--by",
        "Claude, in session",
        "--at",
        "2026-10-25"
      ],
      "exit": 1,
      "out": [
        "never by hand"
      ]
    },
    {
      "run": [
        "work",
        "set",
        "Epic N",
        "--state",
        "blocked",
        "--by",
        "Claude, in session",
        "--at",
        "2026-10-25"
      ],
      "exit": 1,
      "out": [
        "--reason and --waiting-on are required"
      ]
    },
    {
      "run": [
        "work",
        "set",
        "Epic",
        "--state",
        "open",
        "--by",
        "Claude, in session",
        "--at",
        "2026-10-25"
      ],
      "exit": 1,
      "out": [
        "names 14 things"
      ]
    },
    {
      "say": "the critical path",
      "run": [
        "query",
        "ask",
        "WK10",
        "ITEM=workitem.epic-c"
      ],
      "rows": [
        {
          "before.label": "Epic A: federated graphs",
          "before.state": "open"
        },
        {
          "before.label": "Epic K: connectors",
          "before.state": "open"
        }
      ]
    },
    {
      "say": "a merged pull request deploys Epic B; the same event again appends nothing",
      "run": [
        "work",
        "event",
        "merged-pr",
        "--repo",
        "Cynergis/oto",
        "--number",
        "56",
        "--item",
        "Epic B",
        "--environment",
        "prod",
        "--at",
        "2026-10-25"
      ],
      "out": [
        "Epic B: OTO deploy: open -> deployed to prod (github:Cynergis/oto#56, 2026-10-25)"
      ]
    },
    {
      "run": [
        "work",
        "event",
        "merged-pr",
        "--repo",
        "Cynergis/oto",
        "--number",
        "56",
        "--item",
        "Epic B",
        "--environment",
        "prod",
        "--at",
        "2026-10-25"
      ],
      "out": [
        "github:Cynergis/oto#56 already recorded as transition.epic-b-1; nothing appended"
      ]
    },
    {
      "run": [
        "build"
      ]
    },
    {
      "run": [
        "query",
        "ask",
        "WK12"
      ],
      "rows": [
        {
          "w.label": "Epic B: OTO deploy",
          "w.deployed_to": "prod"
        },
        {
          "w.label": "Epic L: selected text and tools",
          "w.deployed_to": "prod"
        }
      ]
    },
    {
      "run": [
        "query",
        "ask",
        "CM2",
        "ITEM=workitem.epic-m"
      ],
      "rows": [
        {
          "m.from": "Claude, in session",
          "m.status": "resolved",
          "r.from": "Chiheb Dkhil",
          "r.outcome": "resolved"
        },
        {
          "m.from": "Chiheb Dkhil",
          "m.status": "pending",
          "p.label": "Chiheb Dkhil",
          "r.from": "—"
        }
      ],
      "say": "the thread beside the item: the question, resolved, and the answer, a message in its own right"
    },
    {
      "say": "the audit log: every write chained, who touched the epic",
      "run": [
        "audit",
        "verify"
      ],
      "out": [
        "chain intact"
      ]
    },
    {
      "run": [
        "audit",
        "for",
        "workitem.epic-m"
      ],
      "out": [
        "work set",
        "work notify",
        "work reply",
        "refused",
        "Claude, in session",
        "Chiheb Dkhil"
      ]
    }
  ]
}
